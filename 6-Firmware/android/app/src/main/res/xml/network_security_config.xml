<?xml version="1.0" encoding="utf-8"?>
<!-- IT: HTTP in chiaro solo verso lo strumento. EN: Cleartext HTTP only towards the instrument. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">iotester.local</domain>
    </domain-config>
</network-security-config>
